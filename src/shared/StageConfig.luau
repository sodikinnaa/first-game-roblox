-- Runtime graybox geometry; generated by MapBuilderService, not baked Workspace.
-- Gently bending ascending route. Heights are deck centres; decks are 2 studs thick.
-- The builder distributes edge gaps from actual deck edges, never centre lerps.
local StageConfig = {}

StageConfig.STAGES = {
    { stage = 1, name = "Welcome Meadow", pos = Vector3.new(0, 10, 0), size = Vector3.new(24, 2, 24), stoneWidth = 14, stoneCount = 6, color = Color3.fromRGB(133, 185, 128), material = Enum.Material.Grass },
    { stage = 2, name = "Cloud Garden", pos = Vector3.new(33.0253, 22, 123.2521), size = Vector3.new(24, 2, 24), stoneWidth = 12, stoneCount = 7, color = Color3.fromRGB(160, 201, 161), material = Enum.Material.Grass },
    { stage = 3, name = "Breeze Bridge", pos = Vector3.new(88.1347, 36, 241.4347), size = Vector3.new(24, 2, 24), stoneWidth = 12, stoneCount = 8, color = Color3.fromRGB(202, 176, 140), material = Enum.Material.WoodPlanks },
    { stage = 4, name = "Terrace Grove", pos = Vector3.new(125.7153, 52, 381.6871), size = Vector3.new(24, 2, 24), stoneWidth = 10, stoneCount = 9, color = Color3.fromRGB(146, 192, 135), material = Enum.Material.Grass },
    { stage = 5, name = "Pond Islands", pos = Vector3.new(112.9905, 70, 527.1315), size = Vector3.new(24, 2, 24), stoneWidth = 10, stoneCount = 11, color = Color3.fromRGB(137, 186, 191), material = Enum.Material.SmoothPlastic },
    { stage = 6, name = "Cloud Steps", pos = Vector3.new(54.0262, 90, 689.1345), size = Vector3.new(24, 2, 24), stoneWidth = 10, stoneCount = 12, color = Color3.fromRGB(226, 232, 239), material = Enum.Material.SmoothPlastic },
    { stage = 7, name = "Sky Orchard", pos = Vector3.new(-24.4117, 112, 857.3453), size = Vector3.new(24, 2, 24), stoneWidth = 10, stoneCount = 13, color = Color3.fromRGB(168, 199, 137), material = Enum.Material.Grass },
    { stage = 8, name = "Sunset Walk", pos = Vector3.new(-75.8649, 136, 1049.3713), size = Vector3.new(24, 2, 24), stoneWidth = 10, stoneCount = 14, color = Color3.fromRGB(226, 181, 155), material = Enum.Material.Sand },
    { stage = 9, name = "Summit Approach", pos = Vector3.new(-94.3419, 162, 1260.5646), size = Vector3.new(24, 2, 24), stoneWidth = 10, stoneCount = 15, color = Color3.fromRGB(181, 199, 216), material = Enum.Material.SmoothPlastic },
    { stage = 10, name = "Sky Summit", pos = Vector3.new(-94.3419, 190, 1497.7646), size = Vector3.new(48, 2, 48), color = Color3.fromRGB(237, 228, 207), material = Enum.Material.Marble },
}

-- One rigid yaw/translation preserves every Stage2–10 route and local style.
StageConfig.ORIGINAL_STAGES = StageConfig.STAGES
local oldAnchor = StageConfig.STAGES[2].pos
local delta = StageConfig.STAGES[3].pos - oldAnchor
local length = math.sqrt(delta.X^2 + delta.Z^2)
StageConfig.DownstreamCos = delta.X / length
StageConfig.DownstreamSin = -delta.Z / length
function StageConfig.transformPosition(pos)
    local d = pos - oldAnchor
    return Vector3.new(24 + d.X * StageConfig.DownstreamCos - d.Z * StageConfig.DownstreamSin,
        pos.Y, 143.6 + d.X * StageConfig.DownstreamSin + d.Z * StageConfig.DownstreamCos)
end
local transformed = {}
for index, data in ipairs(StageConfig.ORIGINAL_STAGES) do
    local copy = table.clone(data)
    if index >= 2 then copy.pos = StageConfig.transformPosition(data.pos) end
    transformed[index] = copy
end
StageConfig.STAGES = transformed
return StageConfig
